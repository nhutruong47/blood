# Blood Donation Platform — Environment Variables Template (docker compose)
# Copy this file to `.env` (same directory) and fill in strong, distinct values.
#
# Two separate database credentials are used:
#   * DB_PASSWORD         — password of the SQL Server `sa` principal. Used
#                            ONLY by the init-db one-shot service and operator
#                            tooling (scripts/backup-db.sh, scripts/restore-db.sh).
#                            The running application never sees this value.
#   * BLOOD_APP_PASSWORD  — password of the dedicated `blood_app` login that
#                            the Spring Boot app connects with. Provisioned by
#                            blood-backend/db/init/01-create-app-login.sql.
# Keep these two values distinct and rotate them independently.

# ============================================
# Database (SQL Server) — used by the `sqlserver` and `init-db` services
# ============================================
# Strong password for `sa`. Must satisfy SQL Server 2022 complexity
# requirements (uppercase, lowercase, digit, symbol, >= 8 chars).
DB_PASSWORD=ChangeMe!StrongSaPassword123

# Strong password for `blood_app`. Same complexity rules. Should be different
# from DB_PASSWORD above so that compromising one does not compromise both.
BLOOD_APP_PASSWORD=ChangeMe!StrongAppPassword456

# ============================================
# JWT — MUST be at least 32 characters
# ============================================
JWT_SECRET=replace-this-with-a-real-32-plus-character-secret-key
JWT_EXPIRATION=3600000

# ============================================
# Grafana admin password
# ============================================
GRAFANA_ADMIN_PASSWORD=ChangeMe!Grafana

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
