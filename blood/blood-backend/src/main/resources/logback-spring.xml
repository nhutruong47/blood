<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration: console-friendly in dev, JSON in prod (LOG_FORMAT=json).
  Includes MDC fields (correlationId, userId) when CorrelationIdFilter puts them in scope.
-->
<configuration>
    <springProperty name="appName" source="spring.application.name" defaultValue="blood"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{correlationId:-},%X{userId:-}] %logger{36} - %msg%n"/>

    <!-- JSON encoder for production (parsed by Loki/Elasticsearch/Cloud Logging). -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                {"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","logger":"%logger{36}","thread":"%thread","msg":%msg,"correlationId":"%X{correlationId:-}","userId":"%X{userId:-}"}%n
            </pattern>
        </encoder>
    </appender>

    <!-- Human-readable for local development. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="${LOG_APPENDER:-CONSOLE}"/>
    </root>

    <logger name="com.nhutruong.blood" level="DEBUG"/>
    <!-- Quiet down noisy Spring internals in production. -->
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.hibernate.SQL" level="INFO"/>
</configuration>
