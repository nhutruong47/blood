# Blood Donation Platform - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=BLOOD;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=YourStrongPassword123!

# ============================================
# JWT SECURITY
# ============================================
# MUST be at least 32 characters
JWT_SECRET=your-super-secret-key-that-is-at-least-32-characters-long-change-in-production
JWT_EXPIRATION=86400000

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# FLYWAY
# ============================================
FLYWAY_ENABLED=true

# ============================================
# JPA
# ============================================
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
